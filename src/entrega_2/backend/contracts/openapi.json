{
  "openapi": "3.1.0",
  "info": {
    "title": "TOBIAS API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/auth/cadastro": {
      "post": {
        "tags": [
          "autenticacao"
        ],
        "summary": "Cadastrar",
        "description": "Cria uma conta. O papel e sempre jogador: nunca vem do cliente.",
        "operationId": "cadastrar_v1_auth_cadastro_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CadastroEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioSaida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "autenticacao"
        ],
        "summary": "Login",
        "description": "Confere as credenciais e devolve o token.\n\nA mensagem de erro e a mesma para e-mail inexistente e senha errada,\npara nao revelar quais e-mails estao cadastrados.",
        "operationId": "login_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenSaida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/eu": {
      "get": {
        "tags": [
          "autenticacao"
        ],
        "summary": "Quem Sou Eu",
        "description": "Devolve os dados de quem esta com o token.",
        "operationId": "quem_sou_eu_v1_auth_eu_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioSaida"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/auth/calibracao": {
      "put": {
        "tags": [
          "autenticacao"
        ],
        "summary": "Atualizar Calibracao",
        "description": "Atualiza o nivel de calibracao / dificuldade fisica do jogador.",
        "operationId": "atualizar_calibracao_v1_auth_calibracao_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalibracaoEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioSaida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/drills": {
      "get": {
        "tags": [
          "treinos"
        ],
        "summary": "Listar",
        "description": "Lista treinos com paginacao e filtros.\n\nO jogador ve apenas o catalogo e os proprios treinos, qualquer\nque seja o filtro que ele mande.",
        "operationId": "listar_v1_drills_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "escopo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Escopo"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Escopo"
            }
          },
          {
            "name": "nivel",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Nivel"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Nivel"
            }
          },
          {
            "name": "busca",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Busca"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaTreinos"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "treinos"
        ],
        "summary": "Criar",
        "description": "Cria um treino com a primeira versao.\n\nO escopo e derivado do papel: admin publica no catalogo, jogador\ncria apenas treinos pessoais. Nunca vem do cliente.",
        "operationId": "criar_v1_drills_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TreinoEntrada"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TreinoSaida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drills/{treino_id}": {
      "get": {
        "tags": [
          "treinos"
        ],
        "summary": "Detalhar",
        "description": "Detalhe de um treino, com a versao atual.\n\nDevolve 404 quando o treino existe mas nao e deste usuario: nao\nrevelar a existencia e parte da prevencao de IDOR da US-802.",
        "operationId": "detalhar_v1_drills__treino_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "treino_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Treino Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TreinoSaida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "treinos"
        ],
        "summary": "Editar",
        "description": "Edita um treino publicando uma versao nova.\n\nA versao anterior nao e alterada: as sessoes ja realizadas\ncontinuam apontando para ela, e o historico permanece correto.",
        "operationId": "editar_v1_drills__treino_id__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "treino_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Treino Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TreinoEntrada"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TreinoSaida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "treinos"
        ],
        "summary": "Excluir",
        "description": "Exclusao logica de um treino.\n\nO jogador apaga apenas os proprios treinos pessoais. O admin\napaga qualquer treino, inclusive do catalogo. A linha permanece\nno banco porque as sessoes apontam para as versoes do treino.",
        "operationId": "excluir_v1_drills__treino_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "treino_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Treino Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drills/{treino_id}/versions": {
      "get": {
        "tags": [
          "treinos"
        ],
        "summary": "Listar Versoes",
        "description": "Historico de versoes do treino, da mais nova para a mais antiga.",
        "operationId": "listar_versoes_v1_drills__treino_id__versions_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "treino_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Treino Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VersaoSaida"
                  },
                  "title": "Response Listar Versoes V1 Drills  Treino Id  Versions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/drills/{treino_id}/copy": {
      "post": {
        "tags": [
          "treinos"
        ],
        "summary": "Copiar",
        "description": "Copia um treino para os treinos pessoais de quem chamou.\n\nCopy-on-write da US-609: o original nao e alterado, e a copia\nguarda em origem_id de onde veio.",
        "operationId": "copiar_v1_drills__treino_id__copy_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "treino_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Treino Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TreinoSaida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "tags": [
          "sessoes"
        ],
        "summary": "Ingerir",
        "description": "Recebe um lote de sessoes do app (US-704 / RF19), de forma idempotente.\n\nReenviar o mesmo lote nao duplica nada. O codigo HTTP descreve o\nlote: e sempre 200, e o resultado de cada sessao vem em `situacao`.\n422 so para payload malformado, antes de qualquer acesso ao banco.\nO dono das sessoes e quem esta com o token, nunca o corpo.",
        "operationId": "ingerir_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoteEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoteSaida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/admin/usuarios": {
      "get": {
        "tags": [
          "administracao"
        ],
        "summary": "Listar Usuarios",
        "description": "Lista os usuarios cadastrados. Apenas para admin.\n\nA resposta usa o mesmo UsuarioSaida das outras rotas, entao CPF e\ndata de nascimento continuam fora: nem o admin os ve pela API.",
        "operationId": "listar_usuarios_v1_admin_usuarios_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaUsuarios"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Usado pelo Container Apps e pelo aquecimento antes da demo (US-1004).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CadastroEntrada": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "senha": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "title": "Senha"
          },
          "nome": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Nome"
          },
          "apelido": {
            "type": "string",
            "maxLength": 40,
            "minLength": 2,
            "title": "Apelido"
          },
          "data_nascimento": {
            "type": "string",
            "format": "date",
            "title": "Data Nascimento"
          },
          "perfil": {
            "$ref": "#/components/schemas/Perfil",
            "default": "casual"
          }
        },
        "type": "object",
        "required": [
          "email",
          "senha",
          "nome",
          "apelido",
          "data_nascimento"
        ],
        "title": "CadastroEntrada",
        "description": "Dados que o aplicativo envia para criar uma conta."
      },
      "CalibracaoEntrada": {
        "properties": {
          "calibracao": {
            "type": "number",
            "maximum": 45.0,
            "minimum": 0.0,
            "title": "Calibracao",
            "description": "Graus adicionais de dificuldade para acertos fortes no Tobias"
          }
        },
        "type": "object",
        "required": [
          "calibracao"
        ],
        "title": "CalibracaoEntrada",
        "description": "Nivel de calibracao / dificuldade em graus a ser adicionado aos limiares."
      },
      "ClasseImpacto": {
        "type": "string",
        "enum": [
          "fraco",
          "medio",
          "forte",
          "sem_impacto"
        ],
        "title": "ClasseImpacto"
      },
      "Escopo": {
        "type": "string",
        "enum": [
          "catalogo",
          "pessoal"
        ],
        "title": "Escopo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LanceEntrada": {
        "properties": {
          "uuid_lance": {
            "type": "string",
            "format": "uuid",
            "title": "Uuid Lance"
          },
          "id_lance_firmware": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Id Lance Firmware"
          },
          "bola": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Bola"
          },
          "resultado": {
            "$ref": "#/components/schemas/TipoLance"
          },
          "classe": {
            "$ref": "#/components/schemas/ClasseImpacto"
          },
          "knockout": {
            "type": "boolean",
            "title": "Knockout",
            "default": false
          },
          "angulo": {
            "type": "number",
            "maximum": 180.0,
            "minimum": 0.0,
            "title": "Angulo"
          },
          "ts_ms": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Ts Ms"
          }
        },
        "type": "object",
        "required": [
          "uuid_lance",
          "bola",
          "resultado",
          "classe",
          "angulo",
          "ts_ms"
        ],
        "title": "LanceEntrada",
        "description": "Um lance como o app recebeu do firmware, mais o UUID do app."
      },
      "LoginEntrada": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "senha": {
            "type": "string",
            "title": "Senha"
          }
        },
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "title": "LoginEntrada"
      },
      "LoteEntrada": {
        "properties": {
          "sessoes": {
            "items": {
              "$ref": "#/components/schemas/SessaoEntrada"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Sessoes"
          }
        },
        "type": "object",
        "required": [
          "sessoes"
        ],
        "title": "LoteEntrada"
      },
      "LoteSaida": {
        "properties": {
          "sessoes": {
            "items": {
              "$ref": "#/components/schemas/ResumoSessaoSaida"
            },
            "type": "array",
            "title": "Sessoes"
          }
        },
        "type": "object",
        "required": [
          "sessoes"
        ],
        "title": "LoteSaida"
      },
      "Nivel": {
        "type": "string",
        "enum": [
          "facil",
          "medio",
          "dificil",
          "infantil",
          "personalizado"
        ],
        "title": "Nivel"
      },
      "PaginaTreinos": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TreinoSaida"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "PaginaTreinos",
        "description": "Envelope de paginacao: o app precisa do total para saber se ha proxima pagina."
      },
      "PaginaUsuarios": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/UsuarioSaida"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "PaginaUsuarios"
      },
      "Perfil": {
        "type": "string",
        "enum": [
          "casual",
          "iniciante",
          "infantil"
        ],
        "title": "Perfil"
      },
